---
import background from "@assets/background.jpg";
---

<section
  id="inicio"
  class="relative w-full h-[40vh] md:h-[60vh] flex items-center justify-center text-center text-white px-6"
  style={`
    background-image: url(${background.src});
    background-size: cover;
    background-position: center;
    background-color: rgba(0, 0, 0, 0.5);
    background-blend-mode: multiply;
  `}
>
  <div class="relative z-10 px-4">
    <h1
      class="text-3xl sm:text-4xl md:text-6xl font-bold text-center md:text-left"
    >
      Productos del Campo
    </h1>
    <p
      class="mt-4 text-base sm:text-lg md:text-2xl font-medium text-center md:text-left"
    >
      "Cultivamos calidad, cosechamos confianza."
    </p>
  </div>
</section>
