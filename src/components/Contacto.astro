<section class="py-10" id="contacto">
  <h2 class="text-3xl font-bold text-green-700 text-center">Contáctanos</h2>
  <p class="text-gray-700 mt-4">
    Si tienes preguntas o deseas más información, completa el siguiente
    formulario.
  </p>

  <form
    class="mt-6 bg-white p-6 rounded-lg shadow-lg max-w-lg mx-auto"
    method="POST"
    action="/api/send-email"
  >
    <label class="block text-green-700 font-semibold">name:</label>
    <input
      type="text"
      class="w-full border rounded p-2 mt-2"
      name="name"
      required
    />

    <label class="block text-green-700 font-semibold mt-4"
      >Correo Electrónico:</label
    >
    <input
      type="email"
      class="w-full border rounded p-2 mt-2"
      name="email"
      required
    />

    <label class="block text-green-700 font-semibold mt-4">Mensaje:</label>
    <textarea class="w-full border rounded p-2 mt-2" name="message" required
    ></textarea>

    <button
      type="submit"
      class="mt-4 bg-green-600 text-white px-4 py-2 rounded"
    >
      Enviar
    </button>
  </form>
</section>
