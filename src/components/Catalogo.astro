---
import { products } from "../data/products";
const BASE_URL = import.meta.env.BASE_URL || "/";
---

<section class="py-10" id="catalogo">
	<h2 class="text-3xl font-bold text-green-700 text-center">
		Nuestro Catálogo
	</h2>
	<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-8">
		{
			products
				.sort((a, b) => a.name.localeCompare(b.name))
				.map(
					(product) =>
						product &&
						product.available && (
							<div class="border border-gray-300 p-2 rounded-md shadow-sm bg-white">
								<img
									src={`${BASE_URL}/products/${product.image}`}
									alt={product.name}
									class="rounded-md w-full h-60 object-cover"
								/>
								<div class="flex justify-between items-baseline">
									<h3 class="text-xl font-semibold text-green-600 mt-4">
										{product.name}
									</h3>
									<p class="text-gray-700 font-bold text-sm flex-wrap text-end">
										{product.price}
									</p>
								</div>
							</div>
						),
				)
		}
	</div>
</section>
