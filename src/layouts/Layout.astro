---
export const prerender = true;
import "@styles/global.css";

import location from "@assets/icons/location.png";
import mail from "@assets/icons/mail.png";
import telephone from "@assets/icons/telephone.png";
import whatsapp from "@assets/icons/whatsapp.png";
import facebook from "@assets/icons/facebook.png";
import instagram from "@assets/icons/instagram.png";
import twitter from "@assets/icons/twitter.png";
import linkedin from "@assets/icons/linkedin.png";

const navItems = [
  { label: "Inicio", href: "#inicio" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Catálogo", href: "#catalogo" },
  { label: "Contacto", href: "#contacto" },
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Productos del Campo</title>
    <link rel="icon" type="image/png" href="/productos-del-campo/logo.png" />
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans">
    <header
      id="header"
      class="w-full bg-white/95 backdrop-blur-sm text-green-800 fixed top-0 z-50 shadow-sm transition-all duration-300"
    >
      <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
          const toggleBtn = document.getElementById("mobile-menu-toggle");
          const navLinks = document.getElementById("mobile-menu");
          const header = document.getElementById("header");

          // Header scroll effect
          window.addEventListener("scroll", () => {
            if (window.scrollY > 10) {
              header.classList.add("shadow-md");
            } else {
              header.classList.remove("shadow-md");
            }
          });

          if (toggleBtn && navLinks) {
            toggleBtn.addEventListener("click", () => {
              navLinks.classList.toggle("hidden");
              const isExpanded =
                toggleBtn.getAttribute("aria-expanded") === "true";
              toggleBtn.setAttribute(
                "aria-expanded",
                !isExpanded ? "true" : "false"
              );
            });

            // Close menu when a link is clicked
            const links = navLinks.querySelectorAll("a");
            links.forEach((link) => {
              link.addEventListener("click", () => {
                navLinks.classList.add("hidden");
                toggleBtn.setAttribute("aria-expanded", "false");
              });
            });
          }
        });
      </script>
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center"
      >
        <div class="flex items-center space-x-3">
          <a href="#inicio" class="flex items-center gap-2 group">
            <img
              src="/productos-del-campo/logo.png"
              alt="Logo"
              class="h-12 w-12 transition-transform duration-300 group-hover:scale-110"
            />
            <span class="font-bold text-xl tracking-tight hidden sm:block"
              >Productos del Campo</span
            >
          </a>
        </div>
        <nav class="hidden md:flex items-center gap-8">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="font-medium hover:text-green-600 transition-colors relative after:content-[''] after:absolute after:w-full after:scale-x-0 after:h-0.5 after:bottom-0 after:left-0 after:bg-green-600 after:origin-bottom-right after:transition-transform after:duration-300 hover:after:scale-x-100 hover:after:origin-bottom-left"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          class="md:hidden cursor-pointer text-green-800 focus:outline-none p-2 rounded-md hover:bg-green-50 transition-colors"
          aria-label="Toggle Menu"
          aria-expanded="false"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
      <div
        class="absolute top-full left-0 w-full bg-white border-t border-gray-100 md:hidden hidden shadow-lg"
        id="mobile-menu"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="block px-6 py-4 hover:bg-green-50 hover:text-green-700 transition-colors font-medium border-b border-gray-50 last:border-none"
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </header>

    <main class="w-full pt-20">
      <slot />
    </main>

    <footer class="bg-green-900 text-white pt-16 pb-8 w-full">
      <div
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-12"
      >
        <div class="text-center md:text-left">
          <div
            class="flex items-center justify-center md:justify-start gap-3 mb-6"
          >
            <img
              src="/productos-del-campo/logo.png"
              alt="Logo"
              class="h-12 w-12 bg-white rounded-full p-1"
            />
            <span class="text-xl font-bold">Productos del Campo</span>
          </div>
          <p class="text-green-100 mb-6">
            Llevando lo mejor del campo nicaragüense directamente a tu mesa con
            calidad y frescura garantizada.
          </p>
        </div>

        <div class="text-center md:text-left">
          <h4 class="text-lg font-bold mb-6 text-green-300">Contacto</h4>
          <ul class="space-y-4">
            <li class="flex items-start justify-center md:justify-start gap-3">
              <img src={location.src} class="h-5 w-5 mt-1 opacity-80" />
              <span>Almacén Sony 3 1/2 c al oeste. Estelí</span>
            </li>
            <li class="flex items-center justify-center md:justify-start gap-3">
              <img src={mail.src} class="h-5 w-5 opacity-80" />
              <a
                href="mailto:zb.juanjose@gmail.com"
                class="hover:text-green-300 transition-colors"
                >zb.juanjose@gmail.com</a
              >
            </li>
            <li class="flex items-center justify-center md:justify-start gap-3">
              <img src={telephone.src} class="h-5 w-5 opacity-80" />
              <div class="flex flex-col">
                <a
                  href="tel:+50585088302"
                  class="hover:text-green-300 transition-colors"
                  >Claro: 8508 8302</a
                >
                <a
                  href="tel:+50576889649"
                  class="hover:text-green-300 transition-colors"
                  >Tigo: 7688 9649</a
                >
              </div>
            </li>
          </ul>
        </div>

        <div class="text-center md:text-left">
          <h4 class="text-lg font-bold mb-6 text-green-300">Síguenos</h4>
          <div class="flex justify-center md:justify-start gap-4">
            <a
              href="https://wa.me/+50585088302"
              target="_blank"
              class="bg-white/10 p-2 rounded-full hover:bg-green-600 transition-colors"
            >
              <img src={facebook.src} class="h-6 w-6" />
            </a>
            <a
              href="https://wa.me/+50585088302"
              target="_blank"
              class="bg-white/10 p-2 rounded-full hover:bg-green-600 transition-colors"
            >
              <img src={instagram.src} class="h-6 w-6" />
            </a>
            <a
              href="https://wa.me/+50585088302"
              target="_blank"
              class="bg-white/10 p-2 rounded-full hover:bg-green-600 transition-colors"
            >
              <img src={twitter.src} class="h-6 w-6" />
            </a>
            <a
              href="https://wa.me/+50585088302"
              target="_blank"
              class="bg-white/10 p-2 rounded-full hover:bg-green-600 transition-colors"
            >
              <img src={linkedin.src} class="h-6 w-6" />
            </a>
          </div>
        </div>
      </div>

      <div
        class="mt-12 pt-8 border-t border-green-800 text-center text-green-200 text-sm"
      >
        <p>
          &copy; {new Date().getFullYear()}
          <a href="#inicio" class="hover:text-white transition-colors"
            >Productos del Campo</a
          > - Todos los derechos reservados.
        </p>
      </div>
    </footer>
  </body>
</html>
